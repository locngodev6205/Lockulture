# ==============================================================================
# ENVIRONMENT VARIABLES - CHRONOLOCKET BACKEND & MULTI-AGENT
# ==============================================================================

# Cổng dịch vụ Backend
PORT=8080
ENV=development

# Google Gemini API Key (Bắt buộc - Sử dụng credit GDG cấp)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps Platform Places API Key (Dùng cho Agent 1)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Mô hình Gemini ưu tiên sử dụng
GEMINI_MODEL=gemini-2.5-flash

# Cấu hình lưu trữ hình ảnh (Google Cloud Storage hoặc Local mock)
STORAGE_TYPE=local
GCS_BUCKET_NAME=chronolocket-photos-bucket

# JWT Secret Key
JWT_SECRET=devfest_hackathon_2026_super_secret_jwt_key
