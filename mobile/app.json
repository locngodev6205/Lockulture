{
  "expo": {
    "name": "Lockulture",
    "slug": "lockulture",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lockulture",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lockulture.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B302E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lockulture.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B302E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 80
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Lockulture chụp ảnh để khám phá lịch sử và văn hóa.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép Lockulture tìm nhiệm vụ quanh vị trí của bạn."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
